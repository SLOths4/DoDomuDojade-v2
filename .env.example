# Baza danych (kontener db)
POSTGRES_USER=ddd
POSTGRES_PASSWORD=zmien-to-haslo
POSTGRES_DB=dodomudojade

# Aplikacja
# Losowy ciąg, np. wynik: openssl rand -hex 32
SECRET_KEY=zmien-na-losowy-ciag
HTTP_PORT=80
# true, gdy aplikacja działa przez HTTPS (ciasteczka tylko po HTTPS)
COOKIE_SECURE=false
TIMEZONE=Europe/Warsaw
LOG_LEVEL=INFO
# Adres kontaktowy wysyłany w User-Agent do Wikimedia
CONTACT_EMAIL=sloths4@spolecznaczworka.pl

# Odjazdy (ZTM Poznań, GTFS): wszystkie słupki o tej nazwie
STOP_NAME=AWF
# Opcjonalnie zawężenie do wybranych słupków, np. AWF41,AWF05
STOP_CODES=

# Pogoda
IMGW_WEATHER_URL=https://danepubliczne.imgw.pl/api/data/synop/id/<id_stacji>
AIRLY_API_KEY=
AIRLY_LOCATION_ID=

# Kalendarz Google: plik konta serwisowego wrzuć do katalogu secrets/
GOOGLE_SERVICE_ACCOUNT_FILE=/run/secrets/google-service-account.json
GOOGLE_CALENDAR_ID=
